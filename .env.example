# Ascenda backend — example environment for local development.
# Copy to .env (git-ignored) and adjust. Never commit a real secret.
# Every variable is described in README.md → Environment Variables.

APP_ENV=development
PORT=8080
# Empty listens on every interface; production sets 127.0.0.1 (Caddy on the same host).
BIND_ADDRESS=
LOG_LEVEL=debug

DATABASE_URL=postgres://ascenda:ascenda@localhost:5432/ascenda?sslmode=disable
DB_AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Socrate (OAuth 2.1 / OIDC). Leave SOCRATE_BASE_URL empty to run without sign-in.
# SOCRATE_BASE_URL is the issuer: no trailing slash.
SOCRATE_BASE_URL=
SOCRATE_JWKS_URL=
# Required whenever SOCRATE_BASE_URL is set (never derived). In production: the
# apps VPS's SSH tunnel to Socrate's loopback admin API.
SOCRATE_ADMIN_URL=http://127.0.0.1:18082
SOCRATE_CLIENT_ID=
SOCRATE_CLIENT_SECRET=
SOCRATE_APP_ID=
SOCRATE_REDIRECT_URL=http://localhost:5173/callback
SOCRATE_VERIFY_AUDIENCE=true

# Backend-for-Frontend: server-side sign-in, HttpOnly session cookie (tokens stay here).
# Production: https://ascenda.vandermoten.eu/bff/callback. Empty turns /bff sign-in off (not in production).
BFF_REDIRECT_URL=http://localhost:5173/bff/callback
BFF_COOKIE_NAME=ascenda_session
BFF_SESSION_IDLE_TTL=30m
BFF_SESSION_ABSOLUTE_TTL=8h
# Local development over plain http only; refused in production.
BFF_INSECURE_COOKIE=true

AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
